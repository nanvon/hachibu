    "All original values are preserved. Power records without a verified unit are shown here without conversion. Records without a valid time remain available here and are excluded from charts." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部原值均已保留。单位未确认的功率记录在此按原值展示；时间无效的记录保留在明细中，不绘入曲线。"
          }
        }
      }
    },
