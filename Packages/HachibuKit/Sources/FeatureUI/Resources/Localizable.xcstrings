{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (unit unverified)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（单位未确认）"
          }
        }
      }
    },
    "Import History…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入历史…"
          }
        }
      }
    },
    "How to Export History" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何导出历史"
          }
        }
      }
    },
    "2. Ask it to export your previous battery history and verify the resulting JSON. Do not import an incomplete file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 请工具导出之前的电池历史并核对 JSON，不要导入不完整的文件。"
          }
        }
      }
    },
    "3. Choose Import History… below and select the verified JSON. Review the record counts before confirming." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 点击下方“导入历史…”，选择核对通过的 JSON，检查记录数后确认。"
          }
        }
      }
    },
    "The export tool must verify compatibility before reading the previous database." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出工具必须先确认与原数据库兼容，再读取数据。"
          }
        }
      }
    },
    "Imported records become part of your battery history and appear alongside new measurements. Existing measurements take priority where records overlap." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入记录会加入电池历史，与之后采集的数据一起展示。时间重叠时优先保留应用已采集的值。"
          }
        }
      }
    },
    "Could not load historical records. Please try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载历史记录，请重试。"
          }
        }
      }
    },
    "All Metrics" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
