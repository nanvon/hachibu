    },
    "The %lld days imported from %@ will be removed from the history charts." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld day imported from %@ will be removed from the history charts."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld days imported from %@ will be removed from the history charts."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 %2$@ 导入的 %1$lld 天数据将从历史曲线中移除。"
          }
        }
      }
    },
    "The battery has stayed above %lld °C for 3 minutes. Current temperature: %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池温度已连续 3 分钟高于 %lld °C，当前 %@。"
          }
        }
      }
    },
    "The charge limit is back to your setting." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电上限已恢复为你的设置。"
          }
        }
      }
    },
    "The charge limit is managed by Hachibu. Changes in System Settings are reverted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电上限由 Hachibu 管理，系统设置中的改动会被改回。"
          }
        }
      }
    },
    "The data is from a different battery than the one in this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些数据来自另一块电池，不是本机当前的电池。"
          }
        }
      }
    },
    "The file contains no valid daily data." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件中没有有效的每日数据。"
          }
        }
      }
    },
    "The file does not name the app the data came from." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件没有注明数据来自哪个应用。"
          }
        }
      }
    },
    "The file has no battery serial number, so the capacity ratio can't be calculated for imported days unless they include the design capacity." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件中没有电池序列号。导入的记录如果没有设计容量，就无法计算容量比。"
          }
        }
      }
    },
    "The file is larger than 50 MB." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件超过 50 MB。"
          }
        }
