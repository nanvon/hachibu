            "value" : "%lld 条来源记录"
          }
        }
      }
    },
    "Source timestamps and values are shown without timezone or unit conversion. Text values are quoted; an empty string appears as \"\". Records are ordered by the original timestamp, newest first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间和值均按来源显示，不转换时区或单位。文本带引号，空字符串显示为 \"\"。记录按原始时间倒序排列。"
          }
        }
      }
    },
    "The imported archive could not be found." : {
      "localizations" : {
