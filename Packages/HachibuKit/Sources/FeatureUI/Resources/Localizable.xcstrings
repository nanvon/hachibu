    "Alerts about the charge limit and battery calibration." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电上限和电池校准的相关提醒。"
          }
        }
      }
    },
    "Alerts are checked only while notifications are allowed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有允许通知时才会检查提醒。"
          }
        }
      }
    },
    "Alerts once after the temperature stays above %lld °C for 3 minutes. Can alert again after the temperature stays below %lld °C for 5 minutes. The panel marks the temperature as High at or above the threshold." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度连续 3 分钟高于 %1$lld °C 时提醒一次；连续 5 分钟低于 %2$lld °C 后可再次提醒。达到阈值时，面板把温度标为“偏高”。"
          }
        }
      }
    },
    "Allow Notifications…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
