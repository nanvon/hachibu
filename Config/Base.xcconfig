// Hachibu App target 的构建设置，Debug 和 Release 共用。
// 签名相关的本地设置放在 Local.xcconfig（不提交），见 Local.xcconfig.example。

PRODUCT_NAME = Hachibu
// 首次发布后不能再改，见 docs/v1技术设计.md 第 1 节。
PRODUCT_BUNDLE_IDENTIFIER = io.github.nanvon.hachibu
// 发布版本号 X.Y.Z，必须与发布 tag vX.Y.Z 一致；构建版本跟随它，Sparkle 用它比较新旧。见 docs/打包发布.md。
MARKETING_VERSION = 0.1.4
CURRENT_PROJECT_VERSION = $(MARKETING_VERSION)

MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64
SWIFT_VERSION = 6.0

INFOPLIST_FILE = App/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// App 级强调色为品牌蓝，与 FeatureUI 的 BrandBlue 取值相同。用户在系统设置里选了其他强调色时以用户为准。
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Sparkle 自动更新，见 docs/打包发布.md。appcast 作为附件随每个 GitHub Release 上传，
// 这个地址总是指向最新正式 Release 里的 appcast.xml。
// xcconfig 里 // 会被当成注释，URL 中用 $() 隔开。
SPARKLE_FEED_URL = https:/$()/github.com/nanvon/hachibu/releases/latest/download/appcast.xml
// EdDSA 公钥，用 Sparkle 的 generate_keys 生成后填写，与 GitHub variable SPARKLE_PUBLIC_ED_KEY 相同。
// 公钥可以提交，私钥只放在钥匙串和 GitHub secret 里。为空时不启用更新。
SPARKLE_PUBLIC_ED_KEY = VxTejaIFX3+nr/Mk2tH8MeiJcYcINGM5spSyRhGxtao=
CODE_SIGN_ENTITLEMENTS = App/Hachibu.entitlements
ENABLE_HARDENED_RUNTIME = YES

// 默认本地签名（Sign to Run Locally），clone 后不需要开发者账号即可运行。
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

#include? "Local.xcconfig"
